# Lucent MCP server — pre-sign transaction-safety checks over stdio.
# Deliberately lean: the server installs only ABI decoding and hashing support,
# not the pipeline's heavier signing and post-quantum dependencies.
#
# The label proves namespace ownership to the MCP registry (mcp-publisher
# validates the OCI image carries it) — it MUST match server.json `name`.
FROM python:3.12-slim

LABEL io.modelcontextprotocol.server.name="io.github.beepboop2025/lucent"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir "eth-abi>=5.2,<6" "eth-utils>=6,<7" \
    "eth-hash[pycryptodome]>=0.7,<1" \
    && addgroup --system --gid 10001 lucent \
    && adduser --system --uid 10001 --ingroup lucent --no-create-home lucent

# Only the analysis + server modules are needed at runtime.
COPY scripts/common.py scripts/audit.py scripts/comprehend.py \
     scripts/danger.py scripts/mcp_server.py ./scripts/
COPY lucent ./lucent
# Keep the conventional cache path present for local descriptor tooling. The
# runtime is read-only compatible and never writes fetched data here.
RUN mkdir -p abi_cache

USER 10001:10001
ENTRYPOINT ["python", "scripts/mcp_server.py"]
