{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "ens-eth-registrar-controller",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x253553366Da8546fC250F225fe3d25d0C782303b"
        }
      ]
    }
  },
  "metadata": {
    "owner": "ENS",
    "info": {
      "legalName": "True Names Limited",
      "url": "https://ens.domains"
    },
    "contractName": "ETHRegistrarController"
  },
  "display": {
    "formats": {
      "commit(bytes32)": {
        "intent": "Commit to an ENS registration",
        "fields": [
          {
            "label": "Commitment hash",
            "format": "raw",
            "path": "#.commitment"
          }
        ]
      },
      "register(string,address,uint256,bytes32,address,bytes[],bool,uint16)": {
        "intent": "Register .eth name",
        "interpolatedIntent": "Register {name}",
        "fields": [
          {
            "label": "Name (.eth)",
            "format": "raw",
            "path": "#.name",
            "visible": "always"
          },
          {
            "label": "Amount paid",
            "format": "amount",
            "path": "@.value",
            "visible": "always"
          },
          {
            "label": "Registration period",
            "format": "duration",
            "path": "#.duration",
            "visible": "always"
          },
          {
            "label": "Owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.owner",
            "visible": "always"
          },
          {
            "label": "Resolver",
            "format": "addressName",
            "params": {
              "types": [
                "contract"
              ]
            },
            "path": "#.resolver"
          },
          {
            "label": "Set as primary name",
            "format": "raw",
            "path": "#.reverseRecord"
          },
          {
            "label": "Commit secret",
            "path": "#.secret",
            "visible": "never"
          },
          {
            "label": "Resolver records",
            "path": "#.data.[]",
            "visible": "never"
          },
          {
            "label": "Owner fuses",
            "path": "#.ownerControlledFuses",
            "visible": "never"
          }
        ]
      },
      "renew(string,uint256)": {
        "intent": "Renew .eth name",
        "interpolatedIntent": "Renew {name}",
        "fields": [
          {
            "label": "Name (.eth)",
            "format": "raw",
            "path": "#.name",
            "visible": "always"
          },
          {
            "label": "Amount paid",
            "format": "amount",
            "path": "@.value",
            "visible": "always"
          },
          {
            "label": "Renewal period",
            "format": "duration",
            "path": "#.duration",
            "visible": "always"
          }
        ]
      },
      "recoverFunds(address,address,uint256)": {
        "intent": "Recover tokens",
        "fields": [
          {
            "label": "Token",
            "format": "addressName",
            "params": {
              "types": [
                "token"
              ]
            },
            "path": "#._token"
          },
          {
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#._to"
          },
          {
            "label": "Amount (raw)",
            "format": "raw",
            "path": "#._amount"
          }
        ]
      },
      "transferOwnership(address)": {
        "intent": "Transfer controller ownership",
        "fields": [
          {
            "label": "New owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.newOwner"
          }
        ]
      },
      "renounceOwnership()": {
        "intent": "Renounce controller ownership",
        "fields": []
      },
      "withdraw()": {
        "intent": "Withdraw fees",
        "fields": []
      }
    }
  }
}
