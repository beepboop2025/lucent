# Lucent HTTP preflight service. Analysis is call-scoped; optional verified
# source resolution uses only code-owned RPC/Sourcify destinations. No
# simulation, attester key, or caller-controlled outbound URL exists here.
FROM python:3.12-slim

LABEL org.opencontainers.image.title="Lucent Preflight API"
LABEL org.opencontainers.image.source="https://github.com/beepboop2025/lucent"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LUCENT_ACCESS_MODE=disabled \
    LUCENT_VERIFIED_SOURCE_MODE=off \
    LUCENT_X402_ENABLED=false

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt \
    && addgroup --system --gid 10001 lucent \
    && adduser --system --uid 10001 --ingroup lucent --no-create-home lucent

COPY lucent ./lucent
COPY scripts/common.py scripts/audit.py scripts/comprehend.py scripts/danger.py ./scripts/

USER 10001:10001
EXPOSE 8780

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8780/ready', timeout=2).read()"]

ENTRYPOINT ["uvicorn", "lucent.api:app", "--host", "0.0.0.0", "--port", "8780", "--no-server-header", "--timeout-keep-alive", "5"]
